{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reviewedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": { "type": "string" },
          "decision": { "type": "string", "enum": ["include", "exclude"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "areas": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["audio-effects", "representation", "mixing", "mastering", "evaluation", "spatial-audio"]
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "en": { "type": "string" },
              "zh": { "type": "string" }
            },
            "required": ["en", "zh"],
            "additionalProperties": false
          },
          "reason": { "type": "string" }
        },
        "required": ["sourceId", "decision", "confidence", "areas", "summary", "reason"],
        "additionalProperties": false
      }
    }
  },
  "required": ["reviewedAt", "decisions"],
  "additionalProperties": false
}
